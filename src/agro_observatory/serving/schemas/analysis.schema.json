      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "description": "Achado principal (serve_analysis_headline), o mesmo do gráfico do README.",
          "properties": {
            "crop": {
              "const": "soybean"
            },
            "state_years": {
              "type": "integer"
            },
            "water_deficit_state_years": {
              "type": [
                "integer",
                "null"
              ]
            },
            "first_year": {
              "type": [
                "integer",
                "null"
              ]
            },
            "last_year": {
              "type": [
                "integer",
                "null"
              ]
            },
            "mean_anomaly_water_deficit_years": {
              "type": [
                "number",
                "null"
              ]
            },
            "mean_anomaly_other_years": {
              "type": [
                "number",
                "null"
              ]
            },
            "below_trend_share_water_deficit_years": {
              "type": [
                "number",
                "null"
              ]
            },
            "below_trend_share_all_years": {
              "type": [
                "number",
                "null"
              ]
            },
            "regions_with_positive_correlation": {
              "type": [
                "integer",
                "null"
              ]
            },
            "regions_with_correlation": {
              "type": "integer"
            }
          },
          "required": [
            "crop",
            "state_years",
            "water_deficit_state_years",
            "first_year",
            "last_year",
            "mean_anomaly_water_deficit_years",
            "mean_anomaly_other_years",
            "below_trend_share_water_deficit_years",
            "below_trend_share_all_years",
            "regions_with_positive_correlation",
            "regions_with_correlation"
