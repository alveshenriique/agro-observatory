# Copy to .env and adjust. Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_USER=agro
POSTGRES_PASSWORD=change_me
POSTGRES_DB=agro_observatory
POSTGRES_PORT=5432

# BigQuery production (phase 10b). No credentials here: authentication uses the machine's
# Application Default Credentials (`gcloud auth application-default login`).
BIGQUERY_PROJECT=agro-observatory
BIGQUERY_LOCATION=southamerica-east1
