{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Definições comuns dos arquivos do site",
  "description": "Tipos compartilhados pelos esquemas da camada de servir dados. Em todos os arquivos, null significa \"sem dado\" e 0 é um zero publicado pela fonte.",
  "$defs": {
    "meta": {
      "type": "object",
      "description": "Cabeçalho de todo arquivo publicado.",
      "properties": {
        "schema": {
          "type": "string",
          "description": "Nome do esquema deste arquivo (catalog, municipalities, explore, place, analysis, method, topology, manifest)."
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Versão do esquema; muda quando o formato muda de forma incompatível."
        },
        "data_version": {
          "type": "string",
          "pattern": "^([0-9]{4}\\.[0-9]{2}\\.[0-9]{2}|sample)$",
          "description": "Versão dos dados (AAAA.MM.DD da geração; \"sample\" na amostra do CI)."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora da geração, em UTC."
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_key"
          },
          "uniqueItems": true,
          "description": "Fontes dos dados do arquivo; a atribuição de cada uma está em catalog.json."
        }
      },
      "required": [
        "schema",
        "schema_version",
        "data_version",
        "generated_at",
        "sources"
      ],
      "additionalProperties": false
    },
    "source_key": {
      "enum": [
        "ibge_pam",
        "ibge_localities",
        "ibge_mesh",
        "bcb_ipca",
        "brdwgd",
        "conab_calendar",
        "conab_series"
      ]
    },
    "series": {
      "enum": [
        "soybean",
        "corn",
        "coffee_in_husk",
        "coffee_processed",
        "coffee_arabica",
        "coffee_canephora"
      ],
      "description": "Série publicada. O café total é dividido na quebra de unidade da PAM: em coco até 2001 (coffee_in_husk), beneficiado desde 2002 (coffee_processed)."
    },
    "climate_crop": {
      "enum": [
        "soybean",
        "coffee_arabica"
      ],
      "description": "Culturas da análise de clima × rendimento (o milho fica fora)."
    },
    "year": {
      "type": "integer",
      "minimum": 1974,
      "maximum": 2100
    },
    "years": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/year"
      }
    },
    "integers": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "nullable_integers": {
      "type": "array",
      "items": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "nullable_non_negative_integers": {
      "type": "array",
      "items": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      }
    },
    "numbers": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "nullable_numbers": {
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nullable_strings": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "booleans": {
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "nullable_booleans": {
      "type": "array",
      "items": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "real_value": {
      "type": "object",
      "description": "Valor da produção em mil reais do ano-base (deflacionado pelo IPCA). Só existe a partir de 1995 (ou do início da série): os anos têm a sua própria lista.",
      "properties": {
        "years": {
          "$ref": "#/$defs/years"
        },
        "production_value_real_thousand_brl": {
          "$ref": "#/$defs/nullable_non_negative_integers"
        }
      },
      "required": [
        "years",
        "production_value_real_thousand_brl"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "description": "Parâmetros do método, das variáveis do dbt (ver serve_parameters).",
      "properties": {
        "deflation_base_year": {
          "type": "integer"
        },
        "real_value_first_year": {
          "type": "integer"
        },
        "coffee_unit_break_year": {
          "type": "integer"
        },
        "coffee_breakdown_first_year": {
          "type": "integer"
        },
        "climate_first_harvest_year": {
          "type": "integer"
        },
        "climate_normal_start_year": {
          "type": "integer"
        },
        "climate_normal_end_year": {
          "type": "integer"
        },
        "yield_trend_start_year": {
          "type": "integer"
        },
        "yield_trend_end_year": {
          "type": "integer"
        },
        "stress_z_threshold": {
          "type": "number"
        },
        "heat_tmax_threshold_c": {
          "type": "number"
        },
        "heat_min_extra_hot_days": {
          "type": "number"
        },
        "frost_tmin_threshold_c": {
          "type": "number"
        }
      },
      "required": [
        "deflation_base_year",
        "real_value_first_year",
        "coffee_unit_break_year",
        "coffee_breakdown_first_year",
        "climate_normal_start_year",
        "climate_normal_end_year"
      ],
      "additionalProperties": false
    }
  }
}
